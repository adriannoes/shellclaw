# Optional llama.cpp HTTP server consumed by ShellClaw local provider (PRD §4.4.29)
#
# Edit ExecStart with your llama-server binary, model GGUF path, and listen port (--port must match
# [providers.local] in config.toml, default shellclaw listens on localhost:8080).
[Unit]
Description=llama.cpp HTTP server for ShellClaw fallback
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/llama-server --model /PATH/TO/model.gguf --host 127.0.0.1 --port 8080 -ngl 0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=shellclaw.service

# ShellClaw user service (Phase 4 PRD §4.4.28)
#
# Recommendation: Use Type=simple without --daemon so systemd supervises the main PID directly.
# The --daemon flag is for manual foreground-to-background usage (PID + log files under ~/.shellclaw/).
[Unit]
Description=ShellClaw autonomous agent
After=network-online.target llama-server.service
Wants=network-online.target llama-server.service

[Service]
Type=simple
Environment=SHELLCLAW_HOME=%h/.shellclaw
Environment=SHELLCLAW_INSTALL_BIN=%h/.local/bin/shellclaw
EnvironmentFile=-%h/.shellclaw/.env
ExecStart=%h/.local/bin/shellclaw --config %h/.shellclaw/config.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
